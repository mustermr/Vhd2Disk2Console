# ---------------------------------------------
# Visual Studio / MSBuild
# ---------------------------------------------

# Visual Studio per-user state, caches, Copilot snapshots
.vs/

# User-specific solution/project options
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build output directories
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# MSBuild incremental-build and tracking logs
*.tlog
*.log
*.binlog
*.recipe
*.lastbuildstate
*.CppClean.log

# Link/compile intermediates
*.iobj
*.ipdb
*.ipch
*.pdb
*.idb
*.ilk
*.exp
*.map
*.tli
*.tlh
*.res
*.rsp
*.sbr
*.tmp
*.tmp_proj
*.vspscc
*.vssscc

# Browse / IntelliSense databases
*.db
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb
ipch/

# Resource editor binary cache (regenerated from the .rc)
*.aps

# Upgrade reports
UpgradeLog*.XML
UpgradeLog*.htm
_UpgradeReport_Files/
Backup*/
[Uu]pgrade[Ll]og*.XML

# NuGet
packages/
*.nupkg
project.lock.json

# Test / profiling output
[Tt]est[Rr]esult*/
*.coverage
*.coveragexml
*.psess
*.vsp
*.vspx

# ---------------------------------------------
# Compiled artifacts (C/C++)
# ---------------------------------------------

# Object files
*.slo
*.lo
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# ---------------------------------------------
# Local tool state
# ---------------------------------------------
.claude/
.vscode/

# ---------------------------------------------
# OS cruft
# ---------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
